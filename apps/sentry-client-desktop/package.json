{
  "name": "@sentry/sentry-client-desktop",
  "author": "Xai Foundation",
  "description": "Cross platform desktop client for the Xai Sentry Node",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "repository": "https://github.com/xai-foundation/sentry",
  "scripts": {
    "build": "tsc --build && vite build && electron-builder -p never -c electron-builder-config.js",
    "clean": "rimraf dist && rimraf dist-electron && rimraf release && rimraf public/web && rimraf tsconfig.tsbuildinfo && rimraf vite.config.js && rimraf vite.config.d.ts",
    "dev": "vite",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:preload": "node test/preload.test.cjs"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.0.7",
    "@sentry/core": "workspace:*",
    "@sentry/integrations": "^7.120.4",
    "@sentry/react": "^7.120.4",
    "@sentry/ui": "workspace:*",
    "@sentry/vite-plugin": "^4.9.1",
    "@sentry/web-connect": "workspace:*",
    "classnames": "^2.3.2",
    "clsx": "^1.2.1",
    "crypto-js": "4.2.0",
    "electron-log": "^5.0.1",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "jotai": "^2.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^3.3.3",
    "viem": "^2.18.4"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/express": "^4.17.19",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "@typescript-eslint/parser": "^6.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.15",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7",
    "eslint": "^8.48.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "productName": "Xai Sentry Node"
}
